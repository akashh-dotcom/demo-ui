# =============================================================================
# Manuscript Processor - Environment Configuration
# =============================================================================
# Copy this file to .env and update values for your environment
# =============================================================================

# -----------------------------------------------------------------------------
# MongoDB Configuration
# -----------------------------------------------------------------------------
# For LOCAL development (Docker Compose handles this automatically):
#   Leave commented - uses mongodb://mongodb:27017/RittenhouseXMLConverter
#
# For EXTERNAL MongoDB (Atlas, DocumentDB, or shared instance):
#   Uncomment and set your connection string
# -----------------------------------------------------------------------------
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/RittenhouseXMLConverter

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
# HOST_IP: Your server's public IP or domain name
#   - Development: localhost (default)
#   - Production: your-domain.com or IP address
# -----------------------------------------------------------------------------
HOST_IP=localhost
NODE_ENV=development

# -----------------------------------------------------------------------------
# External API Services
# -----------------------------------------------------------------------------
# USE_EXTERNAL_APIS: Enable external PDF/EPUB processing services
#   - true: Use external microservices (PDF_API_URL, EPUB_API_URL)
#   - false: Use local Python converters
# -----------------------------------------------------------------------------
USE_EXTERNAL_APIS=true

# PDF Processing API
# Development: Uses mock at http://pdf-api:8000 (Docker) or http://localhost:8000
# Production: Set to your actual PDF service URL
# PDF_API_URL=https://pdf-api.yourcompany.com

# EPUB Processing API
# Development: Uses mock at http://epub-api:5001 (Docker) or http://localhost:5001
# Production: Set to your actual EPUB service URL
# EPUB_API_URL=https://epub-api.yourcompany.com

# EPUB Editor Service
# EPUB_EDITOR_URL=https://epub-editor.yourcompany.com

# -----------------------------------------------------------------------------
# AI API Keys (Required for PDF Processing)
# -----------------------------------------------------------------------------
# The PDF processor uses AI models for document analysis.
# Set the API key for your chosen model provider.
#
# For Claude models (claude-sonnet-4, claude-opus-4, etc.):
ANTHROPIC_API_KEY=your-anthropic-api-key-here
#
# For OpenAI models (gpt-4, gpt-4-turbo):
# OPENAI_API_KEY=your-openai-api-key-here
#
# Select which model to use in the Admin > System Settings > PDF Pipeline tab
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# AWS Deployment (for CI/CD)
# -----------------------------------------------------------------------------
# AWS_REGION=us-east-1
# AWS_ACCOUNT_ID=123456789012
# ECR_REPOSITORY=manuscript-processor

# -----------------------------------------------------------------------------
# Quick Start Commands
# -----------------------------------------------------------------------------
# Development (everything local):
#   docker-compose up --build
#
# With external MongoDB:
#   MONGODB_URI="mongodb+srv://..." docker-compose up --build
#
# Production (external MongoDB + external APIs):
#   docker-compose up backend frontend --build
# -----------------------------------------------------------------------------
