# =============================================================================
# Backend Production Dockerfile
# =============================================================================
# Optimized for production with Python converters included
# =============================================================================

FROM node:20-bullseye-slim

# Install Python and build dependencies
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      python3 \
      python3-venv \
      python3-pip \
      build-essential \
      libxml2-dev \
      libxslt1-dev \
      curl && \
    rm -rf /var/lib/apt/lists/* && \
    apt-get clean

WORKDIR /usr/src/app

# Install Node dependencies (production only)
COPY package*.json ./
RUN npm ci --only=production

# Copy application code
COPY . .

# Create Python virtual environment
RUN python3 -m venv /venv
ENV PATH="/venv/bin:$PATH"

# Install Python dependencies for converters
RUN pip install --upgrade pip setuptools wheel && \
    pip install --no-cache-dir \
      -r RittDocConverter/requirements.txt \
      -r PDFtoXMLUsingExcel/requirements.txt || true

# Create directories for uploads and outputs
RUN mkdir -p uploads outputs && \
    chown -R node:node /usr/src/app

# Use non-root user
USER node

# Environment
ENV NODE_ENV=production
ENV PORT=5000

EXPOSE 5000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
  CMD curl -f http://localhost:5000/api/health || exit 1

CMD ["node", "server.js"]
